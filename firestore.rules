rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is super-admin
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin';
    }

    // Helper: check if user is a member of an establishment
    function isEstablishmentMember(estId) {
      return exists(/databases/$(database)/documents/establishments/$(estId)/members/$(request.auth.uid));
    }

    // Helper: check if user is admin of an establishment
    function isEstablishmentAdmin(estId) {
      return get(/databases/$(database)/documents/establishments/$(estId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid || isSuperAdmin();
    }

    match /globalSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // ─── Establishments ─────────────────────────────────────────────
    match /establishments/{estId} {
      allow read: if request.auth != null && (isSuperAdmin() || isEstablishmentMember(estId));
      allow create: if request.auth != null && isSuperAdmin();
      allow update: if request.auth != null && (isSuperAdmin() || isEstablishmentAdmin(estId));
      allow delete: if request.auth != null && isSuperAdmin();

      match /members/{memberId} {
        allow read: if request.auth != null && (isSuperAdmin() || isEstablishmentMember(estId));
        allow write: if request.auth != null && (isSuperAdmin() || isEstablishmentAdmin(estId));
      }
    }

    // ─── Sessions ───────────────────────────────────────────────────
    match /sessions/{sessionId} {
      // Session metadata is not sensitive; actual student data is in Storage.
      // Allow any authenticated user to read session docs so list queries work
      // reliably for establishment admins and members.
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (isSuperAdmin()
            || (request.auth.uid in resource.data.members
                && (resource.data.members[request.auth.uid] == 'owner'
                    || resource.data.members[request.auth.uid] == 'editor')));
      allow delete: if request.auth != null
        && (resource.data.members[request.auth.uid] == 'owner' || isSuperAdmin());

      match /classes/{classId} {
        allow read: if request.auth != null
          && (isSuperAdmin()
              || request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.members
              || (get(/databases/$(database)/documents/sessions/$(sessionId)).data.establishmentId != null
                  && isEstablishmentMember(get(/databases/$(database)/documents/sessions/$(sessionId)).data.establishmentId)));
        allow write: if request.auth != null
          && (isSuperAdmin() || get(/databases/$(database)/documents/sessions/$(sessionId)).data.members[request.auth.uid] in ['owner', 'editor']);
      }

      match /snapshots/{snapshotId} {
        allow read: if request.auth != null
          && (isSuperAdmin()
              || request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.members
              || (get(/databases/$(database)/documents/sessions/$(sessionId)).data.establishmentId != null
                  && isEstablishmentMember(get(/databases/$(database)/documents/sessions/$(sessionId)).data.establishmentId)));
        allow write: if request.auth != null
          && (isSuperAdmin() || get(/databases/$(database)/documents/sessions/$(sessionId)).data.members[request.auth.uid] in ['owner', 'editor']);
      }
    }
  }
}
