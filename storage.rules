rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/sessions/{sessionId}/files/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    // Shared session data (K12AppData blobs) — readable/writable by any authenticated user
    // Access control is enforced at the Firestore session level (members map)
    match /sessions/{sessionId}/k12data.json {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
